{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-blog",
  "account_id": "cd0014ca621ea6587554ab4cc4e02e45",
  // 锁定 Workers 运行时的兼容性行为，改动会影响已上线的行为——
  // 这次是首次部署的当天日期，之后不要再改。
  "compatibility_date": "2026-08-09",

  // 首次上线只发布纯静态站点：评论、邮件订阅这些依赖外部账号
  // （Resend、真实 KV namespace）的功能先不接，worker/*.ts 代码
  // 留着不删，等以后要开邮件订阅时，照 PRD/2026-08-06-launch-checklist.md
  // 的 C1–C3 把 main / kv_namespaces / vars / run_worker_first 这几块
  // 配置加回来即可。
  "assets": {
    "directory": "./dist",
  },
}

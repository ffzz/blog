---
import type { GetStaticPaths } from 'astro';

import PostLayout from '../../layouts/PostLayout.astro';
import { postRoutes } from '../../lib/i18n';

export const getStaticPaths = (() => postRoutes('posts', 'en')) satisfies GetStaticPaths;

const { entry, slug, collection, locale } = Astro.props;
---

<PostLayout {entry} {slug} {collection} {locale} />

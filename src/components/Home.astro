---
import JsonLd from '../components/JsonLd.astro';
import LivingWorldHero from '../components/LivingWorldHero.astro';
import PostList from '../components/PostList.astro';
import { HOME_RECENT_POSTS, SITE, type Locale } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllPostsByLocale, localeUrl } from '../lib/i18n';
import { website } from '../lib/schema';
import { t } from '../lib/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const site = SITE[locale];
const all = await getAllPostsByLocale(locale);
const schema = website(locale);

// 首页截断到最近 N 篇，余下的交给归档页 —— 这是让归档页有独立存在价值的
// 前提。首页列全部时，归档页就是它的重复品，Google 有充分理由不收其中一个。
const entries = all.slice(0, HOME_RECENT_POSTS);
const hasMore = all.length > entries.length;
---

<BaseLayout
  {locale}
  path=""
  title={site.name}
  description={site.tagline}
>
  <LivingWorldHero slot="hero" />
  <JsonLd data={schema} />
  {/* 首页 h1 承载站点核心定位 —— 这是全站权重最高的一个标题。 */}
  <section class="intro">
    <h1>{site.tagline}</h1>
    <p>{site.intro}</p>
  </section>

  <section aria-labelledby="recent">
    <h2 id="recent" class="section-label">{t(locale, 'recent')}</h2>
    <PostList {locale} {entries} />
    {
      hasMore && (
        <a class="view-all" href={localeUrl(locale, 'archive')}>
          {t(locale, 'viewAll')}
        </a>
      )
    }
  </section>
</BaseLayout>

<style>
  .intro {
    margin-bottom: var(--space-3xl);
  }

  /*
   * 这个 h1 语义上仍是全站权重最高的标题（承载站点定位、进 JSON-LD），
   * 但视觉上只比正文大一档 —— 它是一句自我介绍，不是需要占满首屏的巨幅
   * 标语。层级靠颜色拉开：h1 用 --text-1，下面那段 intro 用 --text-3。
   * 字号小了之后 --lh-display(1.1) 就太挤了，换成 --lh-heading。
   */
  .intro h1 {
    font-size: var(--size-lead);
    line-height: var(--lh-heading);
  }

  .intro p {
    margin-top: var(--space-lg);
    color: var(--text-3);
  }

  .section-label {
    font-family: var(--font-body);
    font-size: var(--size-caption);
    font-weight: 400;
    letter-spacing: var(--ls-label);
    color: var(--text-4);
    text-transform: uppercase;
    margin-bottom: var(--space-lg);
  }

  .view-all {
    display: inline-block;
    margin-top: var(--space-xl);
    font-size: var(--size-caption);
    color: var(--text-4);
    letter-spacing: var(--ls-label);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .view-all:hover {
    color: var(--brand);
  }
</style>

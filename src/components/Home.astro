---
import JsonLd from '../components/JsonLd.astro';
import PostList from '../components/PostList.astro';
import { SITE, type Locale } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllPostsByLocale } from '../lib/i18n';
import { website } from '../lib/schema';
import { t } from '../lib/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const site = SITE[locale];
const entries = await getAllPostsByLocale(locale);
const schema = website(locale);
---

<BaseLayout
  {locale}
  path=""
  title={site.name}
  description={site.tagline}
  width="wide"
>
  <JsonLd data={schema} />
  {/* 首页 h1 承载站点核心定位 —— 这是全站权重最高的一个标题。 */}
  <section class="intro">
    <h1>{site.tagline}</h1>
    <p>{site.intro}</p>
  </section>

  <section aria-labelledby="recent">
    <h2 id="recent" class="section-label">{t(locale, 'recent')}</h2>
    <PostList {locale} {entries} />
  </section>
</BaseLayout>

<style>
  .intro {
    max-width: var(--measure);
    margin-bottom: var(--space-3xl);
  }

  .intro h1 {
    font-size: var(--size-h1);
    line-height: var(--lh-display);
  }

  .intro p {
    margin-top: var(--space-lg);
    color: var(--text-3);
  }

  .section-label {
    font-family: var(--font-body);
    font-size: var(--size-caption);
    font-weight: 400;
    letter-spacing: var(--ls-label);
    color: var(--text-4);
    text-transform: uppercase;
    margin-bottom: var(--space-lg);
  }
</style>

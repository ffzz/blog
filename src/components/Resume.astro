---
import type { Locale } from '../consts';
import { CONTACT, RESUME } from '../data/resume';
import BaseLayout from '../layouts/BaseLayout.astro';
import { ogImagePath } from '../lib/og';

/*
 * 简历页。内容与文案全部来自 src/data/resume.ts，这里只负责画。
 *
 * ── 三个和站内其他页面不同的决定 ────────────────────────────────
 *
 * 1) 不 import prose.css。
 *    那套样式是给 Markdown 正文的，这一页是排版过的信息密度页面，
 *    段落、卡片、图表各有各的节奏，套上文章排版反而处处要覆盖。
 *
 * 2) noindex，且 og:image 复用首页那张。
 *    简历带真名等身份信息，不进搜索引擎（robots.txt 里另外挡了训练型爬虫，
 *    见 src/pages/robots.txt.ts 的注释）。而 BaseHead 是**无条件**输出
 *    og:image 的，路径按 ogImagePath(locale, path) 约定 —— 这一页没进
 *    og-pages.ts，那张图根本不会生成，不显式传就是个 404。而且
 *    verify-build.mjs 的死链检查只扫 href/src，扫不到 meta content，
 *    构建不会报错。所以这里显式指回首页那张已存在的图。
 *
 * 3) 四张图用 CSS 定位的条，不用 SVG。
 *    条的位置是百分比，CSS 算得了；而 SVG 里的文字会跟着 viewBox 一起缩放，
 *    375px 窄屏上年份标签会小到读不了，还选不中、搜不到。CSS 条里的字是
 *    真文本，换行、缩放、朗读都是浏览器的默认行为，不需要 role="img"
 *    再补一套替代文本（那反而会把可读的文本对屏幕阅读器藏起来）。
 *    SVG 只用在 icon 上 —— 那才是 SVG 该干的事。
 */

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const r = RESUME[locale];

// ── 时间轴 ─────────────────────────────────────────────────────
// 甘特图与技术栈条共用同一根时间轴，两张图因此可以上下对照着看。

/** `YYYY-MM` → 小数年。2021-11 → 2021.833 */
const toYear = (ym: string): number => {
  const [y, m] = ym.split('-').map(Number);
  return y + (m - 1) / 12;
};

// 构建时间。"至今"的条会随每次构建一起长，这是想要的行为。
const now = new Date();
const nowYear = now.getUTCFullYear() + now.getUTCMonth() / 12;

const axisFrom = Math.floor(Math.min(...r.timeline.map((t) => toYear(t.start))));
const axisTo = Math.ceil(nowYear);
const span = axisTo - axisFrom;

/** 一段时间在轴上的位置，返回百分比。end 为 null 表示至今。 */
const place = (start: string, end: string | null) => {
  const from = toYear(start);
  const to = end ? toYear(end) : nowYear;
  return {
    left: (((from - axisFrom) / span) * 100).toFixed(2),
    width: (((to - from) / span) * 100).toFixed(2),
  };
};

// 刻度均匀分布，所以标签行用 flex + space-between 就能精确对位，
// 不需要给每个标签算 left 百分比 —— 那样首尾两个还会各溢出半个标签宽。
const ticks = Array.from({ length: span + 1 }, (_, i) => axisFrom + i);

const fmtMonth = (ym: string) => {
  const [y, m] = ym.split('-');
  return `${m}/${y}`;
};
const fmtRange = (start: string, end: string | null) =>
  `${fmtMonth(start)} – ${end ? fmtMonth(end) : r.ui.present}`;

const gantt = r.timeline.map((t) => ({ ...t, ...place(t.start, t.end) }));
const stacks = r.stacks.map((s) => ({
  ...s,
  ...place(s.from, s.to),
  range: `${s.from.slice(0, 4)} – ${s.to ? s.to.slice(0, 4) : r.ui.present}`,
}));

/** 链接显示成主机名，比裸 URL 好读。 */
const host = (url: string) => new URL(url).host.replace(/^www\./, '');

// ── 图标 ───────────────────────────────────────────────────────
// 手写的一小套线性图标，统一 24×24、stroke=currentColor。
// 需要的不到十个，为此装一整个图标库不划算。
const ICON = {
  download: '<path d="M12 3v11m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/>',
  mail: '<path d="M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z"/><path d="m3.5 6.5 8.5 6 8.5-6"/>',
  chevron: '<path d="m9 6 6 6-6 6"/>',
  external:
    '<path d="M14 4h6v6M20 4 11 13"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>',
  pulse: '<path d="M3 12h4l3-8 4 16 3-8h4"/>',
  sparkle: '<path d="m12 3 2.2 5.8L20 11l-5.8 2.2L12 19l-2.2-5.8L4 11l5.8-2.2z"/>',
  briefcase:
    '<path d="M4 8h16a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z"/><path d="M9 8V6a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>',
  code: '<path d="m8 7-5 5 5 5M16 7l5 5-5 5M13.5 4l-3 16"/>',
  // 网格而不是「层叠」形：层叠形在 1em 大小下跟下面的学位帽几乎一模一样，
  // 两个章节图标撞脸就等于没有图标。
  grid: '<path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z"/>',
  cap: '<path d="m12 4 10 5-10 5L2 9z"/><path d="M6 11v5c0 1.2 2.7 2.5 6 2.5s6-1.3 6-2.5v-5"/>',
  chart: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
} as const;
---

<BaseLayout
  {locale}
  path="resume"
  title={r.title}
  description={r.description}
  noindex
  ogImage={ogImagePath(locale, '')}
>
  <article class="resume">
    {/* ── 页头 ─────────────────────────────────────────────── */}
    <header class="masthead">
      <p class="badge">
        <span class="dot" aria-hidden="true"></span>{r.availability}
      </p>
      <h1>{r.name}</h1>
      <p class="positioning">{r.positioning}</p>
      <p class="facts">{r.location} · {r.workRights}</p>

      <div class="actions">
        <a class="btn btn-primary" href={CONTACT.resumePdf} download>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"
            ><Fragment set:html={ICON.download} /></svg
          >
          {r.ui.downloadResume}
          <span class="btn-hint">{r.ui.downloadHint}</span>
        </a>
        <a class="btn" href={`mailto:${CONTACT.email}`}>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"
            ><Fragment set:html={ICON.mail} /></svg
          >
          {r.ui.emailMe}
        </a>
      </div>

      <p class="elsewhere">
        <a href={CONTACT.linkedin} rel="me">{CONTACT.linkedinLabel}</a>
        <a href={CONTACT.github} rel="me">{CONTACT.githubLabel}</a>
      </p>
    </header>

    {/* ── 数字概览 ─────────────────────────────────────────── */}
    <section>
      <h2 class="section-head">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"
          ><Fragment set:html={ICON.chart} /></svg
        >{r.heading.stats}
      </h2>
      <dl class="stats">
        {
          r.stats.map((s) => (
            <div class="stat">
              <dt>{s.label}</dt>
              <dd>{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    {/* ── 目前状态 ─────────────────────────────────────────── */}
    <section>
      <h2 class="section-head">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"
          ><Fragment set:html={ICON.pulse} /></svg
        >{r.heading.status}
      </h2>
      <div class="lede">{r.status.map((p) => <p>{p}</p>)}</div>
    </section>

    {/* ── AI 实践：页面重心 ────────────────────────────────── */}
    <section>
      <h2 class="section-head">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"
          ><Fragment set:html={ICON.sparkle} /></svg
        >{r.heading.ai}
      </h2>
      <p class="kicker">{r.kicker.ai}</p>
      <div class="lede"><p>{r.aiIntro}</p></div>

      <figure class="chart">
        <ol class="layers">
          {
            r.aiLayers.map((l, i) => (
              <li style={`--depth:${i}`}>
                <span class="layer-num" aria-hidden="true">
                  {i + 1}
                </span>
                <div>
                  <b>{l.name}</b>
                  <p>{l.desc}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <figcaption>{r.ui.layersCaption}</figcaption>
      </figure>

      <div class="cards">
        {
          r.aiCases.map((c) => (
            <details class="card" open={c.current}>
              <summary>
                <div class="card-top">
                  <h3>{c.name}</h3>
                  <span class="status">{c.status}</span>
                </div>
                <p class="card-lede">{c.summary}</p>
                <svg class="chev icon" viewBox="0 0 24 24" aria-hidden="true">
                  <Fragment set:html={ICON.chevron} />
                </svg>
              </summary>
              <div class="card-body">
                <ul>
                  {c.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
                <p class="tags">
                  <span class="tags-label">{r.ui.stackLabel}</span>
                  {c.stack.map((s) => (
                    <span class="tag">{s}</span>
                  ))}
                </p>
                {c.href && (
                  <a class="out" href={c.href}>
                    {host(c.href)}
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
                      <Fragment set:html={ICON.external} />
                    </svg>
                  </a>
                )}
              </div>
            </details>
          ))
        }
      </div>

      <figure class="chart">
        <ol class="pipeline">
          {
            r.pipeline.map((step, i) => (
              <li>
                {i > 0 && (
                  <svg class="pipe-arrow icon" viewBox="0 0 24 24" aria-hidden="true">
                    <Fragment set:html={ICON.chevron} />
                  </svg>
                )}
                <span class="pipe-node">{step}</span>
              </li>
            ))
          }
        </ol>
        <figcaption>{r.ui.pipelineCaption}</figcaption>
      </figure>
    </section>

    {/* ── 工作经历 ─────────────────────────────────────────── */}
    <section>
      <h2 class="section-head">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"
          ><Fragment set:html={ICON.briefcase} /></svg
        >{r.heading.timeline}
      </h2>
      <p class="kicker">{r.kicker.timeline}</p>

      <figure class="chart" style={`--span:${span}`}>
        <ul class="gantt">
          {
            gantt.map((t) => (
              <li>
                <div class="bar-meta">
                  <b>{t.org}</b>
                  <small>{fmtRange(t.start, t.end)}</small>
                </div>
                <div class="track">
                  <span
                    class:list={['bar', { current: t.current }]}
                    style={`left:${t.left}%;width:${t.width}%`}
                  />
                </div>
              </li>
            ))
          }
        </ul>
        <div class="ruler" aria-hidden="true">
          <div />
          <div class="ruler-ticks">
            {ticks.map((y) => (
              <span>{y}</span>
            ))}
          </div>
        </div>
        <figcaption>{r.ui.ganttCaption}</figcaption>
      </figure>

      <div class="cards">
        {
          r.timeline.map((t) => (
            <details class="card" open={t.current}>
              <summary>
                <div class="card-top">
                  <h3>{t.org}</h3>
                  <span class="status">{fmtRange(t.start, t.end)}</span>
                </div>
                <p class="role">
                  {t.role} · {t.city}
                </p>
                <p class="card-lede">{t.summary}</p>
                <svg class="chev icon" viewBox="0 0 24 24" aria-hidden="true">
                  <Fragment set:html={ICON.chevron} />
                </svg>
              </summary>
              <div class="card-body">
                <ul>
                  {t.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
                <p class="tags">
                  <span class="tags-label">{r.ui.stackLabel}</span>
                  {t.stack.map((s) => (
                    <span class="tag">{s}</span>
                  ))}
                </p>
              </div>
            </details>
          ))
        }
      </div>
    </section>

    {/* ── 能力与技术栈 ─────────────────────────────────────── */}
    <section>
      <h2 class="section-head">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"
          ><Fragment set:html={ICON.code} /></svg
        >{r.heading.skills}
      </h2>
      <p class="kicker">{r.kicker.skills}</p>

      <figure class="chart" style={`--span:${span}`}>
        <ul class="gantt">
          {
            stacks.map((s) => (
              <li>
                <div class="bar-meta">
                  <b>{s.label}</b>
                  <small>{s.range}</small>
                </div>
                {/* 这张图的条一律用淡填充，不用甘特图那个实心的 .current：
                    六条里有四条是「至今」，全实心整张图就糊成一片深蓝，
                    反而看不出长短差异。是否仍在用，右边的年份区间已经写了。 */}
                <div class="track">
                  <span class="bar" style={`left:${s.left}%;width:${s.width}%`} />
                </div>
              </li>
            ))
          }
        </ul>
        <div class="ruler" aria-hidden="true">
          <div />
          <div class="ruler-ticks">
            {ticks.map((y) => (
              <span>{y}</span>
            ))}
          </div>
        </div>
        <figcaption>{r.ui.stackCaption}</figcaption>
      </figure>

      <dl class="toolbox">
        {
          r.toolbox.map((g) => (
            <div>
              <dt>{g.group}</dt>
              <dd>
                {g.items.map((it) => (
                  <span class="tag">{it}</span>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    {/* ── 精选项目 ─────────────────────────────────────────── */}
    <section>
      <h2 class="section-head">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"
          ><Fragment set:html={ICON.grid} /></svg
        >{r.heading.projects}
      </h2>
      <p class="kicker">{r.kicker.projects}</p>
      <ul class="projects">
        {
          r.projects.map((p) => (
            <li>
              <div class="card-top">
                <h3>{p.name}</h3>
                <span class="status">{p.status}</span>
              </div>
              <p>{p.desc}</p>
              {p.href && (
                <a class="out" href={p.href}>
                  {p.hrefLabel ?? host(p.href)}
                  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
                    <Fragment set:html={ICON.external} />
                  </svg>
                </a>
              )}
              <p class="tags">
                {p.stack.map((s) => (
                  <span class="tag">{s}</span>
                ))}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    {/* ── 教育与语言 ───────────────────────────────────────── */}
    <section>
      <h2 class="section-head">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"
          ><Fragment set:html={ICON.cap} /></svg
        >{r.heading.education}
      </h2>
      <ul class="education">
        {
          r.education.map((e) => (
            <li>
              <div>
                <b>{e.degree}</b>
                <small>{e.school}</small>
              </div>
              <span class="period">{e.period}</span>
            </li>
          ))
        }
      </ul>
      <p class="tags">
        {r.languages.map((l) => <span class="tag">{l}</span>)}
      </p>
    </section>

    {/* ── 页尾 CTA ─────────────────────────────────────────── */}
    <section class="closing">
      <h2 class="section-head">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"
          ><Fragment set:html={ICON.mail} /></svg
        >{r.heading.contact}
      </h2>
      <div class="actions">
        <a class="btn btn-primary" href={CONTACT.resumePdf} download>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"
            ><Fragment set:html={ICON.download} /></svg
          >
          {r.ui.downloadResume}
          <span class="btn-hint">{r.ui.downloadHint}</span>
        </a>
        <a class="btn" href={`mailto:${CONTACT.email}`}>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"
            ><Fragment set:html={ICON.mail} /></svg
          >
          {CONTACT.email}
        </a>
      </div>
      <p class="elsewhere">
        <a href={CONTACT.linkedin} rel="me">{CONTACT.linkedinLabel}</a>
        <a href={CONTACT.github} rel="me">{CONTACT.githubLabel}</a>
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  /* ── 通用 ───────────────────────────────────────────────── */

  .resume section {
    margin-top: var(--space-3xl);
  }

  /* 页头本身已经有下内边距，再叠一个 3xl 就把首屏推空了。 */
  .masthead + section {
    margin-top: var(--space-2xl);
  }

  .icon {
    width: 1em;
    height: 1em;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* 章节标题。图标跟中文首字对齐靠 baseline 不靠 center ——
     center 在中英混排时会让图标看起来偏高。 */
  .section-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    font-size: var(--size-h2);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--border);
  }

  .section-head .icon {
    color: var(--brand);
    align-self: center;
  }

  .kicker {
    margin-top: var(--space-md);
    font-size: var(--size-small);
    color: var(--text-4);
  }

  .lede {
    margin-top: var(--space-lg);
    color: var(--text-2);
  }

  .lede p + p {
    margin-top: var(--space-lg);
  }

  /* ── 页头 ───────────────────────────────────────────────── */

  .masthead {
    padding-block: var(--space-lg) var(--space-xl);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-xs) var(--space-md);
    border-radius: 999px;
    background: var(--brand-tint);
    color: var(--brand);
    font-size: var(--size-caption);
    letter-spacing: var(--ls-label);
  }

  /* 呼吸灯。唯一的循环动画，reduced-motion 下由 base.css 全局压掉。 */
  .dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--brand);
    animation: breathe 2.4s var(--ease) infinite;
  }

  @keyframes breathe {
    50% {
      opacity: 0.35;
    }
  }

  .masthead h1 {
    margin-top: var(--space-lg);
    font-size: var(--size-h1);
    line-height: var(--lh-display);
  }

  .positioning {
    margin-top: var(--space-md);
    font-size: var(--size-lead);
    color: var(--text-2);
    line-height: var(--lh-heading);
  }

  .facts {
    margin-top: var(--space-md);
    font-size: var(--size-small);
    color: var(--text-4);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-lg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--ivory);
    color: var(--text-1);
    font-size: var(--size-small);
    text-decoration: none;
    transition:
      border-color var(--dur) var(--ease),
      background var(--dur) var(--ease);
  }

  .btn:hover {
    border-color: var(--brand);
  }

  /* 唯一一处大面积用强调色的地方。铁律 2 的 5% 预算基本都花在这里，
     所以别的地方一律用 --brand-tint。 */
  .btn-primary {
    background: var(--brand);
    border-color: var(--brand);
    color: var(--parchment);
  }

  .btn-primary:hover {
    opacity: 0.88;
  }

  .btn-hint {
    color: inherit;
    opacity: 0.7;
    font-size: var(--size-caption);
  }

  .elsewhere {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin-top: var(--space-lg);
    font-size: var(--size-small);
  }

  /* ── 数字卡 ─────────────────────────────────────────────── */

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }

  /* dt 是标签、dd 是数字，朗读顺序「交付的客户系统 —— 20+」才通顺；
     视觉上数字要在上，所以这里翻转，而不是把 DOM 写反。 */
  .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-xs);
    padding-left: var(--space-md);
    border-left: 2px solid var(--brand-tint);
  }

  .stat dd {
    margin: 0;
    font-family: var(--font-serif-en);
    font-size: var(--size-h3);

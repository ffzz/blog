---
import { Scene } from './Scene';
---

<section id="living-world-hero" class="living-world-hero" aria-label="3D Living World Welcome Screen">
  <div class="hero-canvas-wrap">
    <Scene client:load />
  </div>

  <div class="hero-overlay">
    <div class="hero-top-badge">
      <span class="badge-dot"></span>
      <span class="badge-text">Interactive Living World</span>
    </div>

    <div class="hero-center-content">
      <p class="hero-eyebrow">A Sanctuary for Thoughts & Craft</p>
      <h1 class="hero-title">Ben's Digital Garden</h1>
      <p class="hero-desc">
        Notes, essays & reflections on engineering, system architecture, and craft.
      </p>
    </div>

    <div class="hero-bottom-action">
      <button id="hero-enter-btn" class="hero-enter-btn" type="button" aria-label="Enter blog content">
        <span class="enter-text">Scroll to explore · Press Enter</span>
        <span class="enter-key" aria-hidden="true">↵</span>
        <svg class="scroll-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 5v14M19 12l-7 7-7-7"/>
        </svg>
      </button>
    </div>
  </div>

  <div class="hero-bottom-fade" aria-hidden="true"></div>
</section>

<script>
  function setupLivingWorldHero() {
    const hero = document.getElementById('living-world-hero');
    const enterBtn = document.getElementById('hero-enter-btn');
    const blogContent = document.getElementById('blog-content');

    if (!hero || !blogContent) return;

    let isTransitioning = false;

    function enterBlog() {
      if (isTransitioning) return;
      isTransitioning = true;
      hero?.classList.add('is-exiting');

      const targetTop = blogContent?.getBoundingClientRect().top + window.scrollY;
      window.scrollTo({
        top: targetTop,
        behavior: 'smooth',
      });

      setTimeout(() => {
        isTransitioning = false;
      }, 1000);
    }

    enterBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      enterBlog();
    });

    // Handle Enter and ArrowDown keys
    const handleKeydown = (e: KeyboardEvent) => {
      if (window.scrollY < window.innerHeight * 0.5) {
        if (e.key === 'Enter' || e.key === 'ArrowDown' || e.key === 'PageDown') {
          e.preventDefault();
          enterBlog();
        }
      }
    };

    // Handle downward scroll / mouse wheel
    let wheelAccumulator = 0;
    let wheelTimer: number | null = null;
    const handleWheel = (e: WheelEvent) => {
      if (window.scrollY < 30 && e.deltaY > 10) {
        wheelAccumulator += e.deltaY;
        if (wheelAccumulator > 30) {
          wheelAccumulator = 0;
          enterBlog();
        }
        if (wheelTimer) clearTimeout(wheelTimer);
        wheelTimer = window.setTimeout(() => {
          wheelAccumulator = 0;
        }, 300);
      }
    };

    window.addEventListener('keydown', handleKeydown);
    window.addEventListener('wheel', handleWheel, { passive: true });

    // When scrolling back to the very top, restore hero overlay elegance
    const handleScroll = () => {
      if (window.scrollY < 50) {
        hero.classList.remove('is-exiting');
      }
    };
    window.addEventListener('scroll', handleScroll, { passive: true });
  }

  // Support Astro view transitions / initial load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupLivingWorldHero);
  } else {
    setupLivingWorldHero();
  }
  document.addEventListener('astro:page-load', setupLivingWorldHero);
</script>

<style>
  .living-world-hero {
    position: relative;
    width: 100vw;
    height: 100dvh;
    min-height: 580px;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    margin-top: calc(-1 * var(--space-lg));
    overflow: hidden;
    background: #4a4d44;
    user-select: none;
  }

  .hero-canvas-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-canvas-wrap :global(.shader-frame),
  .hero-canvas-wrap :global(.threeui-background) {
    width: 100%;
    height: 100%;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    padding: clamp(1.5rem, 5vh, 3.5rem) var(--space-lg) clamp(2rem, 6vh, 4rem);
    pointer-events: none;
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .living-world-hero.is-exiting .hero-overlay {
    opacity: 0;
    transform: translateY(-28px);
    pointer-events: none;
  }

  /* Top badge */
  .hero-top-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.9rem;
    border-radius: 9999px;
    background: rgba(32, 38, 30, 0.55);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(210, 230, 195, 0.22);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    animation: fadeInDown 1s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #84d872;
    box-shadow: 0 0 10px #84d872;
    animation: pulseDot 2.4s ease-in-out infinite;
  }

  .badge-text {
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #e2ecd8;
    font-weight: 500;
  }

  /* Center Typography */
  .hero-center-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 720px;
    padding-inline: var(--space-md);
    animation: fadeInUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
  }

  .hero-eyebrow {
    font-family: var(--font-body);
    font-size: clamp(0.75rem, 1.4vw, 0.88rem);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #c9dec0;
    margin-bottom: 0.75rem;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.6);
    font-weight: 500;
  }

  .hero-title {
    font-family: var(--font-serif-en);
    font-size: clamp(2.4rem, 6.5vw, 4.4rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin: 0 0 1rem;
    background: linear-gradient(145deg, #ffffff 0%, #edf4e4 40%, #c4dfb4 80%, #f7f9f3 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 4px 20px rgba(0, 0, 0, 0.55));
    animation: titleShimmer 8s ease-in-out infinite alternate;
  }

  .hero-desc {
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.8vw, 1.15rem);
    line-height: 1.55;
    color: rgba(240, 245, 235, 0.88);
    max-width: 560px;
    margin: 0;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.75);
  }

  /* Bottom Enter Button & Prompt */
  .hero-bottom-action {
    display: flex;
    flex-direction: column;
    align-items: center;
    animation: fadeInUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.4s both;
  }

  .hero-enter-btn {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.6rem 1.3rem;
    border-radius: 9999px;
    background: rgba(26, 32, 24, 0.65);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(220, 240, 205, 0.32);
    color: #f5f8f0;
    font-family: var(--font-body);
    font-size: 0.84rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    cursor: pointer;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(255, 255, 255, 0.06);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-enter-btn:hover {
    background: rgba(38, 48, 36, 0.85);
    border-color: rgba(220, 240, 205, 0.65);
    transform: translateY(-2px);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.45), 0 0 20px rgba(160, 220, 140, 0.25);
    color: #ffffff;
  }

  .hero-enter-btn:active {
    transform: translateY(0);
  }

  .enter-key {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    font-size: 0.75rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #e2ecd8;
    line-height: 1;
  }

  .scroll-arrow {
    stroke: #b8dba2;
    animation: bounceDown 2s ease-in-out infinite;
  }

  /* Bottom fade mask into Kami background */
  .hero-bottom-fade {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 120px;
    background: linear-gradient(
      to bottom,
      rgba(74, 77, 68, 0) 0%,
      rgba(74, 77, 68, 0.35) 40%,
      var(--parchment) 100%
    );
    pointer-events: none;
    z-index: 3;
  }

  @keyframes pulseDot {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.45;
      transform: scale(0.85);
    }
  }

  @keyframes titleShimmer {
    0% {
      filter: drop-shadow(0 4px 20px rgba(0, 0, 0, 0.55));
    }
    100% {
      filter: drop-shadow(0 4px 28px rgba(160, 210, 140, 0.35));
    }
  }

  @keyframes bounceDown {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }

  @keyframes fadeInDown {
    from {
      opacity: 0;
      transform: translateY(-16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-top-badge,
    .hero-center-content,
    .hero-bottom-action,
    .badge-dot,
    .hero-title,
    .scroll-arrow {
      animation: none !important;
    }
  }
</style>

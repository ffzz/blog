---
import { AUTHOR, type Locale } from '../consts';
import { localeUrl } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
const rss = locale === 'zh' ? '/zh/rss.xml' : '/rss.xml';
---

<footer class="footer">
  <span>© {year} {AUTHOR.name}</span>
  <span class="links">
    <a href={rss}>RSS</a>
    <a href={localeUrl(locale, 'about')}>About</a>
  </span>
</footer>

<style>
  .footer {
    display: flex;
    justify-content: space-between;
    gap: var(--space-lg);
    flex-wrap: wrap;
    margin-top: var(--space-3xl);
    padding-block: var(--space-xl);
    border-top: 1px solid var(--border);
    font-size: var(--size-caption);
    color: var(--text-4);
  }

  .links {
    display: flex;
    gap: var(--space-lg);
  }

  .links a {
    color: var(--text-4);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .links a:hover {
    color: var(--brand);
  }
</style>

---
import { AUTHOR, EMAIL_SUBSCRIBE_ENABLED, type Locale } from '../consts';
import { localeUrl } from '../lib/i18n';
import { t } from '../lib/ui';
import Subscribe from './Subscribe.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
const rss = locale === 'zh' ? '/zh/rss.xml' : '/rss.xml';
---

<footer class="footer">
  {EMAIL_SUBSCRIBE_ENABLED && <Subscribe {locale} />}

  <div class="bottom">
    <span>© {year} {AUTHOR.name}</span>
    <span class="links">
      <a href={rss}>RSS</a>
      <a href={localeUrl(locale, 'about')}>{t(locale, 'navAbout')}</a>
      <a href={localeUrl(locale, 'privacy')}>{t(locale, 'privacyLabel')}</a>
    </span>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-3xl);
    padding-block: var(--space-xl);
    border-top: 1px solid var(--border);
    font-size: var(--size-caption);
    color: var(--text-4);
  }

  .footer :global(.subscribe) {
    max-width: 26rem;
    margin-bottom: var(--space-xl);
  }

  .bottom {
    display: flex;
    justify-content: space-between;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .links {
    display: flex;
    gap: var(--space-lg);
  }

  .links a {
    color: var(--text-4);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .links a:hover {
    color: var(--brand);
  }
</style>

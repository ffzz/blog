{
  "name": "blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/heading-font.mjs --check && node scripts/og-fonts.mjs && astro build && node scripts/verify-build.mjs && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "fonts": "node scripts/heading-font.mjs",
    "fonts:check": "node scripts/heading-font.mjs --check",
    "og:fonts": "node scripts/og-fonts.mjs",
    "whoami": "node --env-file=.env.local ./node_modules/wrangler/bin/wrangler.js whoami",
    "deploy": "node --env-file=.env.local ./node_modules/wrangler/bin/wrangler.js deploy"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.1.6",
    "astro-og-canvas": "^0.13.0",
    "beautiful-mermaid": "^1.1.3",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "markdown-it": "^15.0.0",
    "sanitize-html": "^2.17.6",
    "unist-util-visit": "^5.1.0",
    "wawoff2": "^2.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/markdown-it": "^14.1.2",
    "@types/sanitize-html": "^2.16.1",
    "pagefind": "^1.5.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.118.0"
  }
}
